# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pharma_repurpose
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=pharma-reports
S3_REGION=us-east-1
USE_MINIO=true

# JWT Auth
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Configuration
BOLT_LLM_ENDPOINT=https://api.bolt.new/v1/llm
BOLT_LLM_API_KEY=your-bolt-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEFAULT_LLM_PROVIDER=openai
LLM_MAX_RETRIES=3
LLM_TIMEOUT=30

# External API Configuration
IQVIA_API_URL=http://localhost:8001
IQVIA_API_KEY=mock-key
EXIM_API_URL=http://localhost:8002
EXIM_API_KEY=mock-key
USPTO_API_URL=http://localhost:8003
CLINICAL_TRIALS_API_URL=http://localhost:8004
WEB_SEARCH_API_URL=http://localhost:8005

# Worker Configuration
WORKER_TIMEOUT=20
WORKER_RETRY_LIMIT=3
WORKER_RETRY_BACKOFF=2

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=300
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Caching
CACHE_TTL_SECONDS=86400
CACHE_ENABLED=true

# Monitoring
ENABLE_METRICS=true
LOG_LEVEL=INFO

# PII Redaction
ENABLE_PII_REDACTION=true

# Data Retention
DATA_RETENTION_DAYS=90

# Environment
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
